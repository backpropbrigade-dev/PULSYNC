# PULSYNC Environment Configuration

# Database Configuration (PostgreSQL / Supabase or SQLite fallback)
DATABASE_URL=sqlite:///./pulsync.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API Credentials (Optional for local MVP)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Frontend API URL Configuration
VITE_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Recommendation Engine Scoring Weights (Formula: 0.30 + 0.20 + 0.20 + 0.20 + 0.10 = 1.0)
W_INTENT=0.30
W_PAGE=0.20
W_USER=0.20
W_RECENT=0.20
W_INFO=0.10
